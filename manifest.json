{
  "manifest_version": 3,
  "name": "KITTTTY-Youtube-Extension",
  "version": "1.0.1",
  "description": "Replaces YouTube images with random cat images.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": ["Content.js"],
      "run_at": "document_idle"
    }
  ]
}
